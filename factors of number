// write a program to print the factors of given number using recursion


#include<stdio.h>
void factor(int i,int a)
{
    if(i>a)
    {
        return;
    }
    if(a%i==0)
    {
        printf("%d is a factor \n",i);
    }
    factor(i+1,a);
}
void main()
{
    int a;
    printf("enter the number\n");
    scanf("%d",&a);
    factor(1,a);
}
